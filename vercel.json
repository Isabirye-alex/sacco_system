{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/register",
      "destination": "/public/register.html"
    },
    {
      "source": "/dashboard",
      "destination": "/public/dashboard.html"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
